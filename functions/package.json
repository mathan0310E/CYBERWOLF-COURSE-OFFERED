{
  "name": "@cyberwolf/functions",
  "version": "1.0.0",
  "private": true,
  "description": "Trusted Node.js backend for CyberWolf 360 (registrations, admin, audit, email)",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions --project demo-cyberwolf360",
    "deploy": "firebase deploy --only functions",
    "clean": "rm -rf lib"
  },
  "dependencies": {
    "@cyberwolf/pricing": "*",
    "@cyberwolf/shared-types": "*",
    "@cyberwolf/validation": "*",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.1.0",
    "helmet": "^8.0.0",
    "nodemailer": "^6.9.16",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/nodemailer": "^6.4.16",
    "typescript": "^5.6.3"
  }
}
