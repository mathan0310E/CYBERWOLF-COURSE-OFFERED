{
  "name": "cyberwolf360",
  "version": "1.0.0",
  "private": true,
  "description": "CyberWolf 360 course registration platform (public site + private admin + trusted backend)",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "functions",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:public": "npm run dev -w @cyberwolf/public-site",
    "dev:admin": "npm run dev -w @cyberwolf/private-admin",
    "build:public": "npm run build -w @cyberwolf/public-site",
    "build:admin": "npm run build -w @cyberwolf/private-admin",
    "build:packages": "npm run build -w @cyberwolf/shared-types && npm run build -w @cyberwolf/pricing && npm run build -w @cyberwolf/validation",
    "build:functions": "npm run build -w @cyberwolf/functions",
    "build": "npm run build:packages && npm run build:functions && npm run build:public && npm run build:admin",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "emulators": "firebase emulators:start --project demo-cyberwolf360",
    "emulators:exec": "firebase emulators:exec --project demo-cyberwolf360",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:watch": "vitest --config tests/vitest.config.ts",
    "test:security": "vitest run --config tests/vitest.config.security.ts",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:all": "npm run test && npm run test:security && npm run test:e2e",
    "audit:security": "npm audit --audit-level=high",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "provision:admin": "node scripts/provision-admin.mjs",
    "clean": "rm -rf node_modules apps/*/node_modules functions/node_modules packages/*/node_modules apps/*/dist functions/lib packages/*/dist"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.9.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "firebase-tools": "^13.29.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "@firebase/util@1.12.1": true,
    "@firebase/util@1.10.0": true,
    "protobufjs@7.6.6": true
  }
}
