# -----------------------------------------------------------------------------
# CyberWolf 360 — environment template (placeholders only)
# Copy to `.env` for local development and fill in real values.
# NEVER commit a real `.env` file. Only `.env.example` belongs in version control.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Public (Vite) configuration — SAFE to expose to the browser.
# Anything prefixed with VITE_ is embedded in the client bundle.
# -----------------------------------------------------------------------------
VITE_PUBLIC_FIREBASE_API_KEY=
VITE_PUBLIC_FIREBASE_AUTH_DOMAIN=
VITE_PUBLIC_FIREBASE_PROJECT_ID=
VITE_PUBLIC_FIREBASE_STORAGE_BUCKET=
VITE_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
VITE_PUBLIC_FIREBASE_APP_ID=
VITE_PUBLIC_RECAPTCHA_SITE_KEY=

# Admin app public config (same Firebase project, separate app + deployment).
VITE_ADMIN_FIREBASE_API_KEY=
VITE_ADMIN_FIREBASE_AUTH_DOMAIN=
VITE_ADMIN_FIREBASE_PROJECT_ID=
VITE_ADMIN_FIREBASE_STORAGE_BUCKET=
VITE_ADMIN_FIREBASE_MESSAGING_SENDER_ID=
VITE_ADMIN_FIREBASE_APP_ID=
VITE_ADMIN_RECAPTCHA_SITE_KEY=

# Base URL of the trusted backend API (Cloud Functions / secured Node API).
VITE_API_BASE_URL=http://127.0.0.1:5001/demo-cyberwolf360/us-central1/api

# -----------------------------------------------------------------------------
# Backend-only secrets — SERVER SIDE ONLY. Never prefix with VITE_.
# In production use a secret manager (Google Secret Manager, etc.).
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CyberWolf 360 <no-reply@example.com>"
ORGANISATION_EMAIL=registrations@example.com

PUBLIC_SITE_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174

# Comma-separated list of origins allowed to call the API (CORS allow-list).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Firebase emulator connection (local development only).
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
GCLOUD_PROJECT=demo-cyberwolf360
FIREBASE_CONFIG={"projectId":"demo-cyberwolf360","storageBucket":"demo-cyberwolf360.appspot.com"}

# Admin provisioning script (run locally, never deployed).
# Creates/updates a Firebase Auth user and sets the admin custom claim.
PROVISION_ADMIN_EMAIL=
PROVISION_ADMIN_PASSWORD=
